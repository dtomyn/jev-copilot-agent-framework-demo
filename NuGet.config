<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Pin this repository to nuget.org only. Central Package Management (NU1507) requires
       exactly one source, or explicit package source mapping. Machine-level feeds must not
       leak into a public demo build. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
