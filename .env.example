# ---------------------------------------------------------------------------
# Decision provider
# ---------------------------------------------------------------------------
# Which System-One engine answers the typed questions. All three speak POST /v1/systemone.
#   jev     = TypeSafe Jev, hosted (https://api.typesafe.ai/v1/systemone)
#   laya    = Laya, open source, served locally by laya-serve (see docs/LAYA.md)
#   decider = Mapika Decider, open source, served locally by decider.serve (see docs/DECIDER.md)
# Unset: laya when LAYA_BASE_URL is set, then decider when DECIDER_BASE_URL is set, otherwise jev.
DECISION_PROVIDER=laya

# off  = deterministic hard rules only; every other mutation needs human approval (hook only)
# mock = deterministic local simulator, no network
# live = call the selected provider
# auto = live when the provider is configured, otherwise off (hook only)
DECISION_MODE=mock

# Wall-clock budget for the preToolUse hook's own decision, in milliseconds.
# Keep this below `timeoutSec` in .github/hooks/jev-policy.json: Copilot fails OPEN on a hook
# timeout, so the hook must return its own `ask` first. Default 4000.
DECISION_HOOK_DEADLINE_MS=4000

# The earlier JEV_MODE and JEV_HOOK_DEADLINE_MS names are still read when the DECISION_* ones
# are unset, so an existing shell session or .env keeps working.

# ---------------------------------------------------------------------------
# Laya (open source, local)
# ---------------------------------------------------------------------------
# Base URL of laya-serve. The default is the host port published by laya-local/docker-compose.yml
# (8010 rather than 8000, because http.sys reserves 8000 on Windows). Setting this alone is
# enough to select the Laya provider.
LAYA_BASE_URL=http://127.0.0.1:8010

# Only needed when the server itself was started with LAYA_API_KEY set. An unauthenticated local
# container wants no Authorization header at all.
LAYA_API_KEY=

# english | multilingual | typed-decisions, or a Hugging Face id. Leave empty to let Laya's
# router pick per request and report its choice in the response's `routing` block.
LAYA_MODEL=

# Where scripts/laya-up.* looks for the compose project (docker-compose.yml plus the laya/
# checkout). It lives outside this repository because Laya is an upstream checkout.
LAYA_HOME=C:/laya-local


# ---------------------------------------------------------------------------
# Decider (open source, local)
# ---------------------------------------------------------------------------
# The repository Docker setup publishes decider.serve on loopback port 8011 so it can run beside
# Laya on 8010. Setting this makes Decider Live mode available in the UI.
DECIDER_BASE_URL=http://127.0.0.1:8011

# Read by the Decider server/container, not sent as the request-level `model` field.
DECIDER_MODEL=Mapika/decider-4b

# auto | cuda | cuda:<n> | cpu. scripts/decider-up.ps1 -Gpu sets the container to CUDA.
DECIDER_DEVICE=auto

# Host port used by the repository's compose file.
DECIDER_HOST_PORT=8011

# Version of the decider-ai package used when the local Docker image is built.
DECIDER_AI_VERSION=1.6.0

# ---------------------------------------------------------------------------
# Jev (TypeSafe, hosted)
# ---------------------------------------------------------------------------
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
# JEV_BASE_URL=https://api.typesafe.ai/

# ---------------------------------------------------------------------------
# GitHub Copilot runtime (levels 6, 7, 10 only)
# ---------------------------------------------------------------------------
# Read by GitHub.Copilot.SDK / this demo. Leave unset to use the runtime that the SDK's build
# targets download from registry.npmjs.org and copy next to the built assemblies.
# COPILOT_CLI_PATH=/absolute/path/to/copilot
#
# Where Copilot keeps session state and config (defaults to ~/.copilot).
# COPILOT_HOME=
#
# Build-time escape hatches for restricted networks (MSBuild properties, not runtime env):
#   dotnet build -p:CopilotSkipCliDownload=true
#   dotnet build -p:CopilotNpmRegistryUrl=https://your-mirror.example.com
#   dotnet build -p:CopilotCliBinaryPath=/absolute/path/to/copilot
